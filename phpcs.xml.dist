<?xml version="1.0"?>
<ruleset name="FindIP Shield for WooCommerce">
  <description>WordPress and PHP compatibility rules for the WooCommerce integration.</description>
  <file>findip-shield-woocommerce</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="PHPCompatibilityWP">
    <properties>
      <property name="testVersion" value="7.4-"/>
    </properties>
  </rule>
  <config name="minimum_supported_wp_version" value="6.4"/>
</ruleset>

